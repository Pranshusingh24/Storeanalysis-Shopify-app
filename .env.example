# Storeanalysis App Environment Variables (Pranshu Singh Baghel)
# Copy this file to .env and provide your actual development or production secrets.

# ==============================================================================
# 1. Shopify App Credentials (from Shopify Partner Dashboard)
# ==============================================================================
SHOPIFY_API_KEY=75d14d5d475920324080eb0fcb850342
SHOPIFY_API_SECRET=your_shopify_api_secret_here
# Production URL from Render (e.g., https://storeanalysis.onrender.com)
SHOPIFY_APP_URL=https://storeanalysis.onrender.com
SCOPES=read_orders,read_all_orders,read_products,read_inventory
SHOPIFY_APP_HANDLE=storeanalysis

# ==============================================================================
# 2. Database Connection
# ==============================================================================
# For Render Persistent Disk SQLite:
DATABASE_URL="file:/data/production.sqlite"
# For Local Development SQLite:
# DATABASE_URL="file:./dev.sqlite"
# For Render Managed PostgreSQL (if using postgres provider):
# DATABASE_URL="postgresql://user:password@hostname:5432/storeanalysis?sslmode=require"

# ==============================================================================
# 3. Environment & Server
# ==============================================================================
NODE_ENV=production
PORT=3000

# ==============================================================================
# 4. Shopify App Pricing & Billing Configuration
# Reference: https://shopify.dev/docs/apps/launch/billing/shopify-app-pricing
# ==============================================================================
# Set to "false" for live production charging; set to "true" while testing on dev stores
SHOPIFY_BILLING_TEST=false

# Enable if using Partner Dashboard hosted plan selection:
# https://admin.shopify.com/store/:store_handle/charges/:app_handle/pricing_plans
SHOPIFY_USE_MANAGED_PRICING=false

# Optional: Shopify Partner API credentials for server-side Active Subscription query
# SHOPIFY_PARTNER_ORG_ID=your_partner_org_id_here
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=your_partner_api_token_here
# SHOPIFY_APP_GID=gid://shopify/App/12345678

# Webhook Encryption and Verification (auto-handled with SHOPIFY_API_SECRET)
WEBHOOK_SECRET=your_shopify_api_secret_here
